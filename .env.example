# Local development against the dev copy of sentec-tasks-api (feat/projects) on
# AWS Lambda. Both lines, or neither: with them unset the app runs on the
# in-browser mock. Restart `nuxt dev` after changing this file.
#
# Open the app at http://localhost:3000 — never 127.0.0.1 (a different site:
# the cookie will not match and the origin is not on the API's allow-list).
# Google and magic-link sign-in come back through the STAFF dev server on
# port 3000, so keep it running for those; password login needs only this app.
NUXT_DEV_API_PROXY=https://cy2ori3ybex2n5ibpa3j2kxq3e0zyzjo.lambda-url.ap-southeast-3.on.aws
NUXT_PUBLIC_API_BASE=http://localhost:3000
