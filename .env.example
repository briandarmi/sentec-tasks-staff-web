# `pnpm dev` talks to the dev copy of sentec-tasks-api on AWS Lambda BY DEFAULT
# (nuxt.config.ts: DEV_API_URL). /v1 is proxied through this dev server so the
# browser sees one origin and the API's SameSite=Lax st_session cookie sticks.
# Nothing in this file is required; copy it to .env only to change a default,
# and restart `nuxt dev` afterwards.
#
# Open the app at http://localhost:3000 — never 127.0.0.1 (a different site:
# the cookie will not match and the origin is not on the API's allow-list).
# Google and magic-link sign-in come back through the STAFF dev server on
# port 3000, so keep it running for those; password login needs only this app.

# Run on the in-browser mock instead of the dev API (what the tests use):
#NUXT_USE_MOCK=1

# Proxy /v1 to a different API, e.g. a local `go run ./cmd/server`:
#NUXT_DEV_API_PROXY=http://localhost:8080

# Where the browser sends /v1 calls: this app's OWN dev server, never the
# Function URL itself (that breaks the cookie). Rarely needs changing.
#NUXT_PUBLIC_API_BASE=http://localhost:3000
